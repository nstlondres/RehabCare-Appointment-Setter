<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - RehabCare PH</title>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link rel="stylesheet" href="~/Content/bootstrap.css" />
    <link rel="stylesheet" href="~/Content/animate.min.css" />
    <link rel="stylesheet" href="~/Content/slick.css" />
    <link rel="stylesheet" href="~/Content/slick-theme.css" />
    <link rel="stylesheet" href="~/Content/jquery.fancybox.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.13.1/css/all.min.css" />
    <link rel="stylesheet" href="~/Content/style.css" />
    <link rel="stylesheet" href="~/Content/UserAccount.css" />

</head>
<body ng-app="UserAccount">
    <div class="page-wrapper">

        <section class="header-uper">
            <div class="container">
                <div style="display:flex; align-items:center; justify-content:space-between;">
                    <div class="hospital-brand d-flex align-items-center">
                        <img src="/Content/images/favicon.png" style="width:50px; height:50px; margin-right:12px; flex-shrink:0;" alt="RehabCare Logo" />
                        <div>
                            <h4>RehabCare Hospital</h4>
                            <span>Rehabilitation Therapy Booking System</span>
                        </div>
                    </div>
                    <div id="guestHeaderActions" style="margin-right:40px;">
                        <a href="/UserAccount/Registration" class="btn-style-one" style="margin-right:8px;">
                            <i class="fas fa-user-plus"></i> Register
                        </a>
                        <a href="/UserAccount/Login" class="btn-style-one" style="background:#1a2942;">
                            <i class="fas fa-sign-in-alt"></i> Login
                        </a>
                    </div>
                    <div id="userHeaderActions" style="margin-right:40px; display:none;">
                        <a href="/UserAccount/UserProfile" class="btn-style-one" style="margin-right:8px;">
                            <i class="fas fa-user-circle"></i> User Profile
                        </a>
                        <a href="#" id="headerLogout" class="btn-style-one" style="background:#e53935;">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <div class="services-bar">
            <div class="container">
                <span><i class="fas fa-walking"></i> Physical Therapy</span>
                <span><i class="fas fa-hands"></i> Occupational Therapy</span>
                <span><i class="fas fa-lungs"></i> Respiratory Therapy</span>
                <span><i class="fas fa-comment-medical"></i> Speech-Language Therapy</span>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg navbar-dark" style="position:relative;">
            <div class="container">
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarLinks">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarLinks">
                    <ul class="navbar-nav">
                        <li class="nav-item @(ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")">
                            <a class="nav-link" href="/"><i class="fas fa-home"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/UserAccount/BookAppointment">
                                <i class="fas fa-calendar-plus"></i> Appointment
                            </a>
                        </li>
                        <li id="adminDashboardNav" class="nav-item @(ViewContext.RouteData.Values["action"].ToString() == "Dashboard" ? "active" : "")">
                            <a class="nav-link" href="/UserAccount/Dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
                        </li>
                        <li class="nav-item @(ViewContext.RouteData.Values["action"].ToString() == "Contact" ? "active" : "")">
                            <a class="nav-link" href="/Home/Contact"><i class="fas fa-phone-alt"></i> Contact Us</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        @RenderBody()

        <footer class="footer">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-4 text-center text-md-left mb-3 mb-md-0">
                        <div class="footer-brand">
                            <i class="fas fa-heartbeat"></i> RehabCare Hospital
                        </div>
                        <p style="font-size:12px; margin-top:4px;">Rehabilitation Therapy Booking System</p>
                    </div>
                    <div class="col-md-4 text-center mb-3 mb-md-0">
                        <div class="footer-links">
                            <a href="/UserAccount/Login">Login</a>
                            <a href="/UserAccount/Registration">Register</a>
                            <a href="/UserAccount/Dashboard">Dashboard</a>
                        </div>
                    </div>
                    <div class="col-md-4 text-center text-md-right">
                        <p>&copy; @DateTime.Now.Year RehabCare Hospital. All rights reserved.</p>
                        <p style="font-size:11px;">Manila, Philippines</p>
                    </div>
                </div>
            </div>
        </footer>

    </div>

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.js"></script>
    <script src="~/Scripts/slick.min.js"></script>
    <script src="~/Scripts/medic.js"></script>
    <script src="~/Scripts/angular.min.js"></script>
    <script src="~/Scripts/Holy-Scripts/Module.js"></script>
    <script src="~/Scripts/Holy-Scripts/Controller.js"></script>
    <script src="~/Scripts/Holy-Scripts/Service.js"></script>
    <script>
        (function () {
            var currentUser = null;
            try {
                currentUser = JSON.parse(sessionStorage.getItem("CurrentUser") || "null");
            } catch (e) {
                currentUser = null;
            }

            var guestActions = document.getElementById("guestHeaderActions");
            var userActions = document.getElementById("userHeaderActions");
            var dashboardNav = document.getElementById("adminDashboardNav");
            var profileLink = userActions ? userActions.querySelector("a") : null;
            var logout = document.getElementById("headerLogout");

            if (currentUser) {
                if (guestActions) guestActions.style.display = "none";
                if (userActions) userActions.style.display = "block";
                if (profileLink && currentUser.IsAdmin) {
                    profileLink.href = "/UserAccount/Welcome";
                    profileLink.innerHTML = '<i class="fas fa-user-shield"></i> Admin Panel';
                }
            }

            if (dashboardNav && (!currentUser || !currentUser.IsAdmin)) {
                dashboardNav.style.display = "none";
            }

            if (logout) {
                logout.addEventListener("click", function (event) {
                    event.preventDefault();
                    sessionStorage.removeItem("CurrentUser");
                    window.location.href = "/UserAccount/Login?t=" + new Date().getTime();
                });
            }
        })();
    </script>
</body>
</html>
