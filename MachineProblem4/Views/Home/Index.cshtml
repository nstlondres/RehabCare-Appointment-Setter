@{
    Layout = "~/Views/Shared/_UserAccount.cshtml";
    ViewBag.Title = "Home";
}

<section style="background-image:url('/Content/images/about/therapy.jpg'); background-size:cover; background-position:center; position:relative; padding: 120px 0;">
   
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(26,41,66,0.72); z-index: 0;"></div>

    <div class="container" style="position:relative; z-index:1;">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <p style="color:#0cb8b6; font-weight:600; letter-spacing:2px; text-transform:uppercase; font-size:13px; margin-bottom:12px;">
                    <i class="fas fa-heartbeat"></i> Rehabilitation Therapy Booking System
                </p>
                <h1 style="font-size:48px; font-weight:800; color:#fff; line-height:1.2; margin-bottom:20px;">
                    Restoring Movement, <br><span style="color:#0cb8b6;">Rebuilding Lives</span>
                </h1>
                <p style="color:#ddd; font-size:16px; line-height:1.8; margin-bottom:32px;">
                    Our team of licensed therapists at RehabCare Hospital provides personalized rehabilitation programs to help you recover faster, move better, and live fully.
                </p>
                <div>
                    <a href="/UserAccount/BookAppointment" class="btn-style-one" style="padding:14px 32px; font-size:15px; margin-right:12px;">
                        <i class="fas fa-calendar-check"></i> Book Appointment
                    </a>
                    <a href="#services" class="btn-style-one" style="padding:14px 32px; font-size:15px; background:transparent; border:2px solid #fff;">
                        <i class="fas fa-th-large"></i> Our Services
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<section style="background:#1a2942; padding: 30px 0;">
    <div class="container">
        <div class="row text-center text-white">
            <div class="col-md-3 col-6 mb-3 mb-md-0">
                <h3 style="color:#0cb8b6; font-size:32px; font-weight:800; margin:0;">500+</h3>
                <p style="color:#aaa; margin:0; font-size:13px;">Patients Treated</p>
            </div>
            <div class="col-md-3 col-6 mb-3 mb-md-0">
                <h3 style="color:#0cb8b6; font-size:32px; font-weight:800; margin:0;">4</h3>
                <p style="color:#aaa; margin:0; font-size:13px;">Therapy Specialties</p>
            </div>
            <div class="col-md-3 col-6">
                <h3 style="color:#0cb8b6; font-size:32px; font-weight:800; margin:0;">15+</h3>
                <p style="color:#aaa; margin:0; font-size:13px;">Licensed Therapists</p>
            </div>
            <div class="col-md-3 col-6">
                <h3 style="color:#0cb8b6; font-size:32px; font-weight:800; margin:0;">98%</h3>
                <p style="color:#aaa; margin:0; font-size:13px;">Patient Satisfaction</p>
            </div>
        </div>
    </div>
</section>

<section id="services" style="padding: 70px 0; background:#f0f4f8;">
    <div class="container">
        <div class="text-center mb-5">
            <p style="color:#0cb8b6; font-weight:600; letter-spacing:2px; text-transform:uppercase; font-size:13px;">What We Offer</p>
            <h2 style="font-size:34px; font-weight:800; color:#1a2942;">Our Therapy Services</h2>
            <p style="color:#666; max-width:500px; margin:0 auto;">We provide comprehensive rehabilitation programs tailored to each patient's unique needs and recovery goals.</p>
        </div>
        <div class="row">

            <div class="col-lg-3 col-md-6 mb-4">
                <div style="background:#fff; border-radius:12px; padding:32px 24px; text-align:center; box-shadow:0 4px 20px rgba(0,0,0,0.07); border-top:4px solid #0cb8b6; height:100%; transition: transform 0.2s;"
                     onmouseover="this.style.transform='translateY(-6px)'" onmouseout="this.style.transform='translateY(0)'">
                    <img src="/Content/images/favicon.png" style="width:64px; height:64px; margin-bottom:16px;" alt="icon" />
                    <h5 style="color:#1a2942; font-weight:700; margin-bottom:10px;">Physical Therapy</h5>
                    <p style="color:#888; font-size:14px; line-height:1.7;">Restore movement and function after injury, surgery, or illness through targeted exercises and hands-on treatment.</p>
                    <a href="/UserAccount/BookAppointment" style="color:#0cb8b6; font-weight:600; font-size:13px; text-decoration:none;">
                        Book Now <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div style="background:#fff; border-radius:12px; padding:32px 24px; text-align:center; box-shadow:0 4px 20px rgba(0,0,0,0.07); border-top:4px solid #1a2942; height:100%; transition: transform 0.2s;"
                     onmouseover="this.style.transform='translateY(-6px)'" onmouseout="this.style.transform='translateY(0)'">
                    <img src="/Content/images/favicon.png" style="width:64px; height:64px; margin-bottom:16px;" alt="icon" />
                    <h5 style="color:#1a2942; font-weight:700; margin-bottom:10px;">Occupational Therapy</h5>
                    <p style="color:#888; font-size:14px; line-height:1.7;">Regain independence in daily activities and improve fine motor skills for work, home, and leisure.</p>
                    <a href="/UserAccount/BookAppointment" style="color:#0cb8b6; font-weight:600; font-size:13px; text-decoration:none;">
                        Book Now <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div style="background:#fff; border-radius:12px; padding:32px 24px; text-align:center; box-shadow:0 4px 20px rgba(0,0,0,0.07); border-top:4px solid #0cb8b6; height:100%; transition: transform 0.2s;"
                     onmouseover="this.style.transform='translateY(-6px)'" onmouseout="this.style.transform='translateY(0)'">
                    <img src="/Content/images/favicon.png" style="width:64px; height:64px; margin-bottom:16px;" alt="icon" />
                    <h5 style="color:#1a2942; font-weight:700; margin-bottom:10px;">Respiratory Therapy</h5>
                    <p style="color:#888; font-size:14px; line-height:1.7;">Manage and treat breathing disorders with specialized care plans for improved lung function and quality of life.</p>
                    <a href="/UserAccount/BookAppointment" style="color:#0cb8b6; font-weight:600; font-size:13px; text-decoration:none;">
                        Book Now <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div style="background:#fff; border-radius:12px; padding:32px 24px; text-align:center; box-shadow:0 4px 20px rgba(0,0,0,0.07); border-top:4px solid #1a2942; height:100%; transition: transform 0.2s;"
                     onmouseover="this.style.transform='translateY(-6px)'" onmouseout="this.style.transform='translateY(0)'">
                    <img src="/Content/images/favicon.png" style="width:64px; height:64px; margin-bottom:16px;" alt="icon" />
                    <h5 style="color:#1a2942; font-weight:700; margin-bottom:10px;">Speech-Language Therapy</h5>
                    <p style="color:#888; font-size:14px; line-height:1.7;">Improve communication, swallowing, and cognitive-linguistic skills with evidence-based speech therapy programs.</p>
                    <a href="/UserAccount/BookAppointment" style="color:#0cb8b6; font-weight:600; font-size:13px; text-decoration:none;">
                        Book Now <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>

<section style="padding: 70px 0; background:#fff;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <img src="~/Content/images/about/1.jpg" alt="About RehabCare" style="width:100%; border-radius:12px; box-shadow:0 10px 40px rgba(0,0,0,0.12);" />
            </div>
            <div class="col-lg-6 pl-lg-5">
