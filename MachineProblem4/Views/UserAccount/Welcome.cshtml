@{
    Layout = "~/Views/Shared/_UserAccount.cshtml";
    ViewBag.Title = "Welcome";
}

<section class="page-title text-center" style="background-image:url(/Content/images/background/promo-video.jpg); padding: 60px 0;">
    <div class="container">
        <div class="title-text">
            <h1>Admin Welcome</h1>
        </div>
    </div>
</section>

<section class="section pb-70" style="padding-top: 60px;" ng-init="welcomeFunc()" ng-controller="UserAccountController">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9 text-center">
                <div class="contact-area style-two" style="box-shadow: 0 4px 24px rgba(0,0,0,0.10); border-radius: 8px; padding: 40px;">

                    <div class="section-title text-center mb-4">
                        <h3>Hello, {{currentUser.FName}} {{currentUser.LName}}!</h3>
                        <p>Admin access granted. What would you like to manage?</p>
                    </div>

                    <div class="mb-4">
                        <div style="width:90px; height:90px; border-radius:50%; background:#0cb8b6; display:inline-flex; align-items:center; justify-content:center;">
                            <i class="fas fa-user-md" style="font-size:40px; color:#fff;"></i>
                        </div>
                        <h4 class="mt-3" style="color:#333;">{{currentUser.FName}} {{currentUser.LName}}</h4>
                        <p style="color:#888;">{{currentUser.Username}}</p>
                    </div>

                    <div class="row justify-content-center">
                        <div class="col-md-4 mb-3">
                            <a class="btn-style-one" style="width:100%; text-align:center; display:block; cursor:pointer;"
                               ng-click="redirectFunc('dashboard')">
                                <i class="fas fa-tachometer-alt"></i> Dashboard
                            </a>
                        </div>
                        <div class="col-md-4 mb-3">
                            <a class="btn-style-one" style="width:100%; text-align:center; display:block; cursor:pointer;"
                               ng-click="redirectFunc('registration')">
                                <i class="fas fa-user-plus"></i> Register Patient
                            </a>
                        </div>
                        <div class="col-md-4 mb-3">
                            <a class="btn-style-one" style="width:100%; text-align:center; display:block; cursor:pointer; background:#e53935;"
                               ng-click="logoutFunc()">
                                <i class="fas fa-sign-out-alt"></i> Logout
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>
