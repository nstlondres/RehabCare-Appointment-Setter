@{
    Layout = "~/Views/Shared/_UserAccount.cshtml";
    ViewBag.Title = "Appointment Management";
}

<style>
    .rc-wrapper {
        display: flex;
        align-items: flex-start;
    }

    .rc-sidebar {
        width: 200px;
        flex-shrink: 0;
        background: #fff;
        box-shadow: 2px 0 8px rgba(0,0,0,0.06);
        padding: 14px 0;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
    }

    .rc-sidebar-nav a {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 20px;
        font-size: 14px;
        font-weight: 500;
        color: #666;
        text-decoration: none;
        border-left: 3px solid transparent;
        transition: all 0.15s;
    }

        .rc-sidebar-nav a i {
            font-size: 14px;
            width: 18px;
            text-align: center;
            color: #bbb;
        }

        .rc-sidebar-nav a:hover {
            background: #f0fbfb;
            color: #0cb8b6;
            border-left-color: #0cb8b6;
            text-decoration: none;
        }

            .rc-sidebar-nav a:hover i {
                color: #0cb8b6;
            }

        .rc-sidebar-nav a.rc-active {
            background: #e8f9f9;
            color: #0cb8b6;
            border-left-color: #0cb8b6;
            font-weight: 700;
        }

            .rc-sidebar-nav a.rc-active i {
                color: #0cb8b6;
            }

    .rc-content {
        flex: 1;
        padding: 32px 28px 48px;
        min-width: 0;
    }

    .sortable-th {
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
    }

        .sortable-th:hover {
            background: #0aa9a7 !important;
        }

    .sort-icon {
        margin-left: 4px;
        font-size: 11px;
        opacity: 0.7;
    }

    .pagination-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 18px;
        flex-wrap: wrap;
        gap: 8px;
    }

        .pagination-bar .page-info {
            font-size: 12px;
            color: #888;
        }

    .pagination-btns {
        display: flex;
        align-items: center;
        gap: 0;
        border: 1px solid #ddd;
        border-radius: 6px;
        overflow: hidden;
    }

        .pagination-btns button {
            border: none;
            border-right: 1px solid #ddd;
            background: #fff;
            color: #555;
            padding: 6px 12px;
            font-size: 12px;
            cursor: pointer;
            transition: background 0.15s, color 0.15s;
            white-space: nowrap;
        }

            .pagination-btns button:last-child {
                border-right: none;
            }

            .pagination-btns button:hover:not(:disabled):not(.active) {
                background: #f0fbfb;
                color: #0cb8b6;
            }

            .pagination-btns button.active {
                background: #0cb8b6;
                color: #fff;
                font-weight: 600;
            }

            .pagination-btns button:disabled {
                opacity: 0.38;
                cursor: default;
            }

    .filter-label {
        font-size: 11px;
        font-weight: 600;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
    }

    .query-section {
        background: #f8fffe;
        border: 1px solid #e0f5f5;
        border-radius: 6px;
        padding: 14px;
        margin-bottom: 16px;
    }
</style>

<div class="rc-wrapper">

    <div class="rc-sidebar">
        <nav class="rc-sidebar-nav">
            <a href="/UserAccount/Dashboard"><i class="fas fa-th-large"></i> Dashboard</a>
            <a href="/UserAccount/AppointmentManagement" class="rc-active"><i class="fas fa-calendar-plus"></i> Appointments</a>
            <a href="/UserAccount/Patients"><i class="fas fa-users"></i> Patients</a>
            <a href="/UserAccount/Therapists"><i class="fas fa-user-md"></i> Therapists</a>
            <a href="/UserAccount/Payment"><i class="fas fa-credit-card"></i> Payment</a>
        </nav>
    </div>

    <div class="rc-content" ng-controller="UserAccountController" ng-init="loadApptManagement()">

        <div style="margin-bottom:24px;">
            <h2 style="font-size:22px; font-weight:800; color:#1a2942; margin:0;">Appointment Management</h2>
            <p style="font-size:13px; color:#aaa; margin:2px 0 0;">Assign therapists and manage appointment status</p>
        </div>

        <div class="row">

            <div class="col-lg-4 col-md-5 mb-4">
                <div class="contact-area style-two" style="box-shadow:0 4px 24px rgba(0,0,0,0.10); border-radius:8px; padding:30px;">
                    <div class="section-title mb-3"><h3>Assign Therapist</h3></div>

                    <div class="mb-3">
                        <label>Patient Name</label>
                        <div style="position:relative;">
                            <i class="fas fa-user" style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#0cb8b6; z-index:1;"></i>
                            <input type="text" class="form-control" style="padding-left:36px; background:#f5f5f5;"
                                   ng-model="ApptMgmtPatient" placeholder="Select appointment from table" readonly />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label>Therapy Type</label>
                        <div style="position:relative;">
                            <i class="fas fa-hand-holding-medical" style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#0cb8b6; z-index:1;"></i>
                            <input type="text" class="form-control" style="padding-left:36px; background:#f5f5f5;"
                                   ng-model="ApptMgmtTherapy" placeholder="Therapy type" readonly />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label>Appointment Date <span style="color:#e53935;">*</span></label>
                        <div style="position:relative;">
                            <i class="fas fa-calendar-day" style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#0cb8b6; z-index:1;"></i>
                            <input type="date" class="form-control" style="padding-left:36px;"
                                   ng-model="ApptMgmtDate" ng-change="validateApptMgmtDate()" />
                        </div>
                        <small style="color:#e53935;" ng-show="apptMgmtErrors.ApptMgmtDate">{{apptMgmtErrors.ApptMgmtDate}}</small>
                    </div>

                    <div class="mb-3">
                        <label>Appointment Time <span style="color:#e53935;">*</span></label>
                        <div style="position:relative;">
                            <i class="fas fa-clock" style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#0cb8b6; z-index:1;"></i>
                            <select class="form-control" style="padding-left:36px; appearance:none; -webkit-appearance:none;"
                                    ng-model="ApptMgmtTime" ng-change="validateApptMgmtTime()">
                                <option value="">-- Select Time --</option>
                                <option value="8:00 AM">8:00 AM</option>
                                <option value="9:00 AM">9:00 AM</option>
                                <option value="10:00 AM">10:00 AM</option>
                                <option value="11:00 AM">11:00 AM</option>
                                <option value="1:00 PM">1:00 PM</option>
                                <option value="2:00 PM">2:00 PM</option>
                                <option value="3:00 PM">3:00 PM</option>
                                <option value="4:00 PM">4:00 PM</option>
                            </select>
                            <i class="fas fa-chevron-down" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); color:#0cb8b6; pointer-events:none;"></i>
                        </div>
                        <small style="color:#e53935;" ng-show="apptMgmtErrors.ApptMgmtTime">{{apptMgmtErrors.ApptMgmtTime}}</small>
                    </div>

                    <div class="mb-3">
                        <label>
                            Assign Therapist <span style="color:#e53935;" ng-if="ApptMgmtStatus !== 'Declined'">*</span>
                        </label>

                        <div ng-show="ApptMgmtStatus === 'Declined'"
                             style="padding:10px 14px; background:#fff5f5; border:1px solid #ffcdd2; border-radius:6px; color:#e53935; font-size:13px;">
                            <i class="fas fa-ban"></i> Not required — appointment is declined.
                        </div>

                        <div ng-show="ApptMgmtStatus !== 'Declined'" style="position:relative;">
                            <i class="fas fa-user-md" style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#0cb8b6; z-index:1;"></i>
                            <select class="form-control" style="padding-left:36px; appearance:none; -webkit-appearance:none;"
                                    ng-model="ApptMgmtTherapist"
                                    ng-change="validateApptTherapist()">
                                <option value="">-- Select Therapist --</option>
                                <option ng-repeat="t in getEligibleTherapists()"
                                        value="{{t.TherapistId}}">
                                    {{t.TherapistName}} ({{t.TherapistTimeFrom}} – {{t.TherapistTimeTo}})
                                </option>
                            </select>
                            <i class="fas fa-chevron-down" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); color:#0cb8b6; pointer-events:none;"></i>
                        </div>

                        <div ng-if="ApptMgmtStatus !== 'Declined' && getEligibleTherapists().length === 0 && ApptMgmtTherapy !== ''"
                             style="margin-top:6px; font-size:12px; color:#f59e0b;">
                            <i class="fas fa-exclamation-triangle"></i>
                            No available therapists match this appointment's therapy type and day.
                            <a href="/UserAccount/Therapists" style="color:#0cb8b6; font-weight:600;">Add therapists here.</a>
                        </div>

                        <small style="color:#e53935;" ng-show="apptMgmtErrors.ApptMgmtTherapist">{{apptMgmtErrors.ApptMgmtTherapist}}</small>
                    </div>

                    <!-- Status -->
                    <div class="mb-3">
                        <label>Status <span style="color:#e53935;">*</span></label>
                        <div style="position:relative;">
                            <i class="fas fa-tasks" style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#0cb8b6; z-index:1;"></i>
                            <select class="form-control" style="padding-left:36px; appearance:none; -webkit-appearance:none;"
                                    ng-model="ApptMgmtStatus"
                                    ng-change="onStatusChange()">
                                <option value="">-- Select Status --</option>
                                <option value="Pending">Pending</option>
                                <option value="Accepted">Accepted</option>
                                <option value="Declined">Declined</option>
                            </select>
                            <i class="fas fa-chevron-down" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); color:#0cb8b6; pointer-events:none;"></i>
                        </div>
                        <small style="color:#e53935;" ng-show="apptMgmtErrors.ApptMgmtStatus">{{apptMgmtErrors.ApptMgmtStatus}}</small>
                    </div>

                    <div class="mb-3" ng-if="apptEditIndex >= 0">
                        <label style="font-size:12px; font-weight:600; color:#555; text-transform:uppercase; letter-spacing:.5px;">Payment Status</label>
                        <div style="padding:10px 14px; border-radius:6px; background:#f5f5f5; font-size:13px;">
                            <span ng-if="apptArray[apptEditIndex].PaymentStatus==='Approved'" style="color:#28a745; font-weight:600;"><i class="fas fa-check-circle"></i> Approved</span>
                            <span ng-if="apptArray[apptEditIndex].PaymentStatus==='Rejected'" style="color:#e53935; font-weight:600;"><i class="fas fa-times-circle"></i> Rejected</span>
                            <span ng-if="apptArray[apptEditIndex].PaymentStatus==='Pending Review'" style="color:#0cb8b6; font-weight:600;"><i class="fas fa-file-invoice"></i> Pending Review</span>
                            <span ng-if="!apptArray[apptEditIndex].PaymentStatus || apptArray[apptEditIndex].PaymentStatus==='Unpaid'" style="color:#aaa;"><i class="fas fa-minus-circle"></i> Unpaid</span>
                            <span style="float:right; font-size:11px; color:#aaa;">
                                <a href="/UserAccount/Payment" style="color:#0cb8b6;">Manage in Payment page</a>
                            </span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6 mb-2">
                            <button type="button" class="btn-style-one" style="width:100%; text-align:center;" ng-click="saveApptMgmt()">
                                <i class="fas fa-save"></i> Save
                            </button>
                        </div>
                        <div class="col-6 mb-2">
                            <button type="button" class="btn-style-one" style="width:100%; text-align:center; background:#6c757d;" ng-click="cancelApptMgmt()">
                                <i class="fas fa-times"></i> Cancel
                            </button>
                        </div>
                    </div>

                    <div ng-if="apptEditIndex === -1" class="text-center mt-3" style="color:#aaa; font-size:12px;">
                        <i class="fas fa-info-circle"></i> Click <strong>Edit</strong> on a row to begin.
                    </div>
                </div>
            </div>

            <div class="col-lg-8 col-md-7 mb-4">
                <div class="contact-area style-two" style="box-shadow:0 4px 24px rgba(0,0,0,0.10); border-radius:8px; padding:30px;">
                    <div class="section-title mb-3"><h3>Appointment List</h3></div>

                    <div class="query-section">
                        <p class="filter-label"><i class="fas fa-search"></i> Basic Search</p>
                        <div class="row">
                            <div class="col-md-7 mb-2">
                                <div style="position:relative;">
                                    <i class="fas fa-search" style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#0cb8b6; z-index:1;"></i>
                                    <input type="text" class="form-control" style="padding-left:36px;"
                                           ng-model="apptMgmtSearch" ng-change="resetApptPage()"
                                           placeholder="Search patient name..." />
                                </div>
                            </div>
                            <div class="col-md-5 mb-2">
                                <div style="position:relative;">
                                    <i class="fas fa-tasks" style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#0cb8b6; z-index:1;"></i>
                                    <select class="form-control" style="padding-left:36px; appearance:none; -webkit-appearance:none;"
                                            ng-model="apptMgmtFilterStatus" ng-change="resetApptPage()">
                                        <option value="">All Status</option>
                                        <option value="Pending">Pending</option>
                                        <option value="Accepted">Accepted</option>
                                        <option value="Declined">Declined</option>
                                    </select>
                                    <i class="fas fa-chevron-down" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); color:#0cb8b6; pointer-events:none;"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="query-section">
                        <p class="filter-label"><i class="fas fa-filter"></i> Advanced Filter</p>
                        <div class="row align-items-center">
                            <div class="col-md-4 mb-2">
                                <div style="position:relative;">
                                    <i class="fas fa-hand-holding-medical" style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#0cb8b6; z-index:1;"></i>
                                    <select class="form-control" style="padding-left:36px; appearance:none; -webkit-appearance:none;"
                                            ng-model="apptMgmtFilterTherapy" ng-change="resetApptPage()">
                                        <option value="">All Therapy Types</option>
                                        <option value="Physical Therapy">Physical Therapy</option>
                                        <option value="Occupational Therapy">Occupational Therapy</option>
                                        <option value="Respiratory Therapy">Respiratory Therapy</option>
                                        <option value="Speech-Language Therapy">Speech-Language Therapy</option>
                                    </select>
                                    <i class="fas fa-chevron-down" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); color:#0cb8b6; pointer-events:none;"></i>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <input type="date" class="form-control"
                                       ng-model="apptMgmtFromDate" ng-change="resetApptPage()" />
                            </div>
                            <div class="col-md-3 mb-2">
                                <input type="date" class="form-control"
                                       ng-model="apptMgmtToDate" ng-change="resetApptPage()" />
                            </div>

                            <div class="col-md-2 mb-2">
                                <button type="button" class="btn-style-one" style="width:100%; text-align:center;" ng-click="resetApptMgmtFilters()">
                                    <i class="fas fa-undo"></i> Reset
                                </button>
                            </div>
                        </div>

                        <div ng-if="hasActiveApptFilters()" style="margin-top:8px; font-size:12px; color:#0cb8b6;">
                            <i class="fas fa-info-circle"></i>
                            Filtering by:
                            <strong ng-if="apptMgmtSearch">name "{{apptMgmtSearch}}"</strong>
                            <span ng-if="apptMgmtSearch && (apptMgmtFilterStatus || apptMgmtFilterTherapy || apptMgmtFromDate || apptMgmtToDate)"> + </span>
                            <strong ng-if="apptMgmtFilterStatus">status "{{apptMgmtFilterStatus}}"</strong>
                            <span ng-if="apptMgmtFilterStatus && (apptMgmtFilterTherapy || apptMgmtFromDate || apptMgmtToDate)"> + </span>
                            <strong ng-if="apptMgmtFilterTherapy">therapy "{{apptMgmtFilterTherapy}}"</strong>
                            <span ng-if="apptMgmtFilterTherapy && (apptMgmtFromDate || apptMgmtToDate)"> + </span>
                            <strong ng-if="apptMgmtFromDate || apptMgmtToDate">date {{apptMgmtFromDate || '...'}} → {{apptMgmtToDate || '...'}}</strong>
                            &nbsp;—&nbsp;<strong>{{getFilteredAppts().length}}</strong> result(s)
                        </div>
                    </div>

                    <div ng-if="apptArray.length === 0" class="text-center py-4" style="color:#aaa;">
                        <i class="fas fa-calendar-times" style="font-size:48px; display:block; margin-bottom:10px;"></i>
                        No appointments submitted yet.
                    </div>
                    <div ng-if="apptArray.length > 0 && getFilteredAppts().length === 0" class="text-center py-4" style="color:#aaa;">
                        <i class="fas fa-search" style="font-size:48px; display:block; margin-bottom:10px;"></i>
                        No appointments match your filters.
                    </div>

                    <div class="table-responsive" ng-if="getFilteredAppts().length > 0">
                        <table class="table table-hover" style="background:#fff;">
                            <thead style="background:#0cb8b6; color:#fff;">
                                <tr>
                                    <th>#</th>
                                    <th class="sortable-th" ng-click="sortAppts('ApptFName')">
                                        Patient <i class="fas sort-icon" ng-class="apptSortField==='ApptFName'?(apptSortReverse?'fa-sort-down':'fa-sort-up'):'fa-sort'"></i>
                                    </th>
                                    <th class="sortable-th" ng-click="sortAppts('ApptTherapy')">
                                        Therapy <i class="fas sort-icon" ng-class="apptSortField==='ApptTherapy'?(apptSortReverse?'fa-sort-down':'fa-sort-up'):'fa-sort'"></i>
                                    </th>
                                    <th class="sortable-th" ng-click="sortAppts('ApptDate')">
                                        Date &amp; Time <i class="fas sort-icon" ng-class="apptSortField==='ApptDate'?(apptSortReverse?'fa-sort-down':'fa-sort-up'):'fa-sort'"></i>
                                    </th>
                                    <th>Therapist</th>
                                    <th class="sortable-th" ng-click="sortAppts('ApptStatus')">
                                        Status <i class="fas sort-icon" ng-class="apptSortField==='ApptStatus'?(apptSortReverse?'fa-sort-down':'fa-sort-up'):'fa-sort'"></i>
                                    </th>
                                    <th class="sortable-th" ng-click="sortAppts('PaymentStatus')">
                                        Payment <i class="fas sort-icon" ng-class="apptSortField==='PaymentStatus'?(apptSortReverse?'fa-sort-down':'fa-sort-up'):'fa-sort'"></i>
                                    </th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="appt in getPagedAppts()" ng-class="{'table-active': apptEditIndex === apptArray.indexOf(appt)}">
                                    <td>{{getApptRowNumber($index)}}</td>
                                    <td>{{appt.ApptFName}} {{appt.ApptLName}}</td>
                                    <td>{{appt.ApptTherapy}}</td>
                                    <td>
                                        {{getDisplayDate(appt.ApptDate)}}<br />
                                        <small style="color:#888;">{{appt.ApptTime}}</small>
                                    </td>
                                    <td>
                                        <span ng-if="appt.ApptTherapist">{{appt.ApptTherapist}}</span>
                                        <span ng-if="!appt.ApptTherapist" style="color:#aaa;">
                                            <i class="fas fa-minus-circle"></i> Unassigned
                                        </span>
                                    </td>
                                    <td>
                                        <span ng-if="appt.ApptStatus==='Accepted'" style="color:#28a745; font-weight:600;"><i class="fas fa-check-circle"></i> Accepted</span>
                                        <span ng-if="appt.ApptStatus==='Declined'" style="color:#e53935; font-weight:600;"><i class="fas fa-times-circle"></i> Declined</span>
                                        <span ng-if="appt.ApptStatus==='Pending'" style="color:#f59e0b; font-weight:600;"><i class="fas fa-clock"></i> Pending</span>
                                    </td>
                                    <td>
                                        <span ng-if="appt.PaymentStatus==='Approved'" style="color:#28a745; font-weight:600;"><i class="fas fa-check-circle"></i> Approved</span>
                                        <span ng-if="appt.PaymentStatus==='Rejected'" style="color:#e53935; font-weight:600;"><i class="fas fa-times-circle"></i> Rejected</span>
                                        <span ng-if="appt.PaymentStatus==='Pending Review'" style="color:#0cb8b6; font-weight:600;"><i class="fas fa-file-invoice"></i> Pending Review</span>
                                        <span ng-if="!appt.PaymentStatus || appt.PaymentStatus==='Unpaid'" style="color:#aaa;"><i class="fas fa-minus-circle"></i> Unpaid</span>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm" style="background:#0cb8b6; color:#fff; margin-right:4px;"
                                                ng-click="editApptMgmt(apptArray.indexOf(appt))">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>
                                        <button class="btn btn-sm btn-danger"
                                                ng-click="delApptFunc(apptArray.indexOf(appt))">
                                            <i class="fas fa-trash-alt"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="pagination-bar">
                            <span class="page-info">Showing {{getApptRangeStart()}}–{{getApptRangeEnd()}} of {{getFilteredAppts().length}} appointments</span>
                            <div class="pagination-btns">
                                <button ng-click="goToApptPage(1)" ng-disabled="apptPage === 1">First</button>
                                <button ng-click="prevApptPage()" ng-disabled="apptPage === 1">&#8249;</button>
                                <button ng-repeat="p in getApptPages() track by p" ng-class="{'active': p === $parent.apptPage}" ng-click="goToApptPage(p)">{{p}}</button>
                                <button ng-click="nextApptPage()" ng-disabled="apptPage === getApptTotalPages()">&#8250;</button>
                                <button ng-click="goToApptPage(getApptTotalPages())" ng-disabled="apptPage === getApptTotalPages()">Last</button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
